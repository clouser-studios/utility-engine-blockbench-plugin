{
	"name": "utility_engine",
	"title": "Utility Engine",
	"icon": "icon.svg",
	"version": "1.0.1",
	"min_blockbench_version": "5.1.6",
	"variant": "desktop",
	"tags": [
		"Minecraft: Java Edition",
		"Utility Engine",
		"Animation"
	],
	"author": {
		"name": "SnaveSutit & Clouser Studios",
		"email": "snavesutit@gmail.com",
		"url": "https://discordapp.com/users/213746232923783168"
	},
	"repository": {
		"type": "github",
		"url": "https://github.com/SnaveSutit/utility-mod-blockbench-plugin"
	},
	"description": "A Blockbench plugin for creating Utility Engine models.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/src/index.d.ts",
	"private": true,
	"scripts": {
		"build:scripts": "esbuild --log-level=warning --bundle --platform=node --outfile=dist/build.cjs --packages=external ./.scripts/esbuild.ts",
		"dev": "bun run build:scripts && node ./dist/build.cjs --mode=dev",
		"prod": "bun run build:scripts && node ./dist/build.cjs",
		"format": "prettier --write .",
		"check-formatting": "prettier . --check",
		"lint": "eslint . --max-warnings=0 --no-warn-ignored",
		"test": "bun run prod && jest",
		"test:watch": "jest --watch"
	},
	"devDependencies": {
		"@snavesutit/jestbench": "^0.2.0",
		"@swc/core": "^1.16.1",
		"@swc/jest": "^0.2.39",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^26.4.1",
		"blockbench-types": "^5.1.0",
		"esbuild": "^0.28.2",
		"esbuild-plugin-import-glob": "^0.1.1",
		"esbuild-plugin-inline-image": "^0.0.9",
		"esbuild-plugin-svelte": "^0.1.1",
		"eslint": "^10.9.1",
		"eslint-plugin-check-file": "^3.3.2",
		"eslint-plugin-svelte": "^3.23.0",
		"jest": "^30.5.1",
		"jiti": "^2.7.0",
		"node-modules-vscode-problems-patch": "^1.0.9",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-eslint-parser": "^1.8.1",
		"svelte-patching-tools": "^1.0.15",
		"svelte-preprocess": "^6.0.5",
		"svelte-preprocess-esbuild": "^3.0.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.69.0"
	},
	"dependencies": {
		"blockbench-patch-manager": "1.3.2",
		"fs-extra": "^11.4.0",
		"js-yaml": "^5.4.1",
		"simple-subpub": "^1.2.0",
		"svelte-observable-store": "^1.0.1"
	},
	"license": "MIT",
	"packageManager": "bun@1.3.14",
	"trustedDependencies": [
		"@parcel/watcher",
		"@swc/core",
		"unrs-resolver"
	]
}
