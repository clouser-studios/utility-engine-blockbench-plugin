{
	"name": "utility-engine",
	"title": "Utility Engine",
	"icon": "icon.svg",
	"version": "0.3.0",
	"min_blockbench_version": "5.0.7",
	"variant": "desktop",
	"tags": [
		"Minecraft: Java Edition",
		"Utility Engine",
		"Animation"
	],
	"author": {
		"name": "SnaveSutit & Clouser Studios",
		"email": "snavesutit@gmail.com",
		"url": "https://discordapp.com/users/213746232923783168"
	},
	"repository": {
		"type": "github",
		"url": "https://github.com/SnaveSutit/utility-mod-blockbench-plugin"
	},
	"description": "A Blockbench plugin for creating Utility Engine models.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/src/index.d.ts",
	"private": true,
	"scripts": {
		"build:scripts": "esbuild --log-level=warning --bundle --platform=node --outfile=dist/build.cjs --packages=external ./.scripts/esbuild.ts",
		"dev": "bun run build:scripts && node ./dist/build.cjs --mode=dev",
		"prod": "bun run build:scripts && node ./dist/build.cjs",
		"format": "prettier --write .",
		"check-formatting": "prettier . --check",
		"lint": "eslint . --max-warnings=0 --no-warn-ignored"
	},
	"devDependencies": {
		"@types/fs-extra": "^11.0.4",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.13.1",
		"@typescript-eslint/eslint-plugin": "^5.54.0",
		"@typescript-eslint/parser": "^5.54.0",
		"envbench": "^2.0.2",
		"esbuild": "^0.24.2",
		"esbuild-plugin-import-glob": "^0.1.1",
		"esbuild-plugin-inline-image": "^0.0.9",
		"esbuild-plugin-svelte": "^0.1.1",
		"eslint": "^9.19.0",
		"eslint-plugin-check-file": "^3.3.0",
		"eslint-plugin-svelte": "^2.46.1",
		"jiti": "^2.4.2",
		"node-modules-vscode-problems-patch": "^1.0.2",
		"prettier": "3",
		"prettier-plugin-svelte": "3",
		"svelte": "^5.46.3",
		"svelte-patching-tools": "^1.0.8",
		"svelte-preprocess": "^6.0.3",
		"svelte-preprocess-esbuild": "^3.0.1",
		"ts-loader": "^9.2.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.23.0"
	},
	"dependencies": {
		"blockbench-patch-manager": "https://github.com/SnaveSutit/blockbench-patch-manager.git",
		"fs-extra": "^11.2.0",
		"js-yaml": "^4.1.0",
		"simple-subpub": "^1.0.2",
		"svelte-observable-store": "^1.0.1"
	},
	"license": "MIT",
	"packageManager": "bun@1.3.14"
}
