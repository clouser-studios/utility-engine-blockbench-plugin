{
	"include": ["src/**/*", ".scripts/esbuild.ts", "eslint.config.ts"],
	"exclude": ["**/node_modules/**"],
	"compilerOptions": {
		"outDir": "./dist/",
		"noImplicitAny": true,
		"module": "ES2022",
		"target": "ES2022",
		"moduleResolution": "node",
		"strict": true,
		"types": ["node"],
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"allowUmdGlobalAccess": true,
		"allowUnreachableCode": true,
		"esModuleInterop": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"alwaysStrict": true,
		"baseUrl": ".",
		"paths": {
			"@package": ["./src/package"],
			"@utility/*": ["./src/*"],
			"@assets/*": ["./src/assets/*"],
			"@events": ["./src/util/events"],
			"@blockbench-tools": ["./src/util/moddingTools"]
		}
	}
}
