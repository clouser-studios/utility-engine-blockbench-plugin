{
	"$schema": "http://json.schemastore.org/prettierrc",
	"tabWidth": 4,
	"useTabs": true,
	"semi": false,
	"singleQuote": true,
	"arrowParens": "avoid",
	"printWidth": 100,
	"trailingComma": "es5",
	"plugins": ["prettier-plugin-svelte"],
	"bracketSameLine": false,
	"overrides": [
		{ "files": "*.ts", "options": { "parser": "typescript" } },
		{ "files": "*.svelte", "options": { "parser": "svelte" } }
	]
}
